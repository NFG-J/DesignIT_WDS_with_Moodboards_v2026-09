{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designit.local/schemas/package-manifest.schema.json",
  "title": "DesignIT Style Package Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "packageId",
    "version",
    "name",
    "projectId",
    "sourceBoardRevision",
    "sourceProposalId",
    "sourceProposalVersion",
    "createdAt",
    "generator",
    "components",
    "assets",
    "hashes",
    "licenses",
    "validation"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "packageId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "sourceBoardRevision": { "type": "integer", "minimum": 0 },
    "sourceProposalId": { "type": "string", "minLength": 1 },
    "sourceProposalVersion": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "required": ["type", "model"],
      "properties": {
        "type": { "type": "string" },
        "model": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "properties": {
        "html": { "type": "string" },
        "javascript": { "type": "string" },
        "api": { "type": "string" }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "mimeType", "provenance"],
        "properties": {
          "path": { "type": "string" },
          "mimeType": { "type": "string" },
          "provenance": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "hashes": { "type": "object", "additionalProperties": { "type": "string" } },
    "licenses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "required": ["status", "checkedAt", "messages"],
      "properties": {
        "status": { "enum": ["passed", "failed", "warnings"] },
        "checkedAt": { "type": "string", "format": "date-time" },
        "messages": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
